# -----------------------------------------------------------------------------
# SENTINEL GLOBAL - TACTICAL ENVIRONMENT CONFIGURATION
# -----------------------------------------------------------------------------

# [ CORE APP ]
# URL of the main application (used for absolute links, OAuth callbacks, etc.)
# Local/Docker testing: http://localhost:4000
# Production: your real https:// domain, e.g. https://sentinel.example.com
NEXTAUTH_URL="http://localhost:3000"
# Secret used to encrypt JWT sessions. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="your_secure_random_secret_here"

# [ PRODUCTION DOMAIN - used by Caddy for automatic HTTPS ]
# Only needed when actually deploying publicly (docker-compose's
# sentinel-proxy service). Must be a real domain with its DNS A record
# pointed at your server's IP — Caddy can't get a cert for "localhost".
DOMAIN=""

# [ OAUTH LOGIN - GOOGLE ]
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
# Leave blank to hide the "Continue with Google" button entirely.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# [ OAUTH LOGIN - GITHUB ]
# Create at https://github.com/settings/developers (New OAuth App)
# Authorization callback URL: {NEXTAUTH_URL}/api/auth/callback/github
# Leave blank to hide the "Continue with GitHub" button entirely.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# [ DATABASE - SUPABASE POSTGRES ]
# From your Supabase project: Settings > Database > Connection string
# DATABASE_URL = "Transaction" pooler string (port 6543) — what the app uses at runtime
# DIRECT_URL   = "Session"/direct string (port 5432) — used only by `prisma migrate`
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# [ SUPABASE PROJECT ]
# From your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_public_key"
# Service role key — server-side ONLY, never expose to the client/browser
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"
# Storage bucket used for uploads (create it in Supabase Storage first)
SUPABASE_STORAGE_BUCKET="sentinel-uploads"

# [ CACHE & RATE LIMITING - REDIS ]
# Required for persistent rate limiting across multiple server instances
REDIS_URL="redis://localhost:6379"

# [ CTF SANDBOX ORCHESTRATION ]
# Set to 'true' to enable production-grade gVisor isolation (Linux only)
CTF_USE_GVISOR=false
# Maximum number of concurrent CTF instances allowed on the host
CTF_MAX_CONCURRENT_INSTANCES=10

# [ TACTICAL COMMS - EMAIL ]
# SMTP configuration for verification emails and alerts
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="notifications@sentinel-global.com"
SMTP_PASS="your_smtp_password"
SMTP_FROM="Sentinel Global <no-reply@sentinel-global.com>"

# [ EXTERNAL INTEL SOURCES ]
# Comma-separated list of RSS feeds to aggregate
SIGNAL_SOURCES="https://krebsonsecurity.com/feed/,https://thehackernews.com/feeds/posts/default,https://www.bleepingcomputer.com/feed/"
